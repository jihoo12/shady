# Collision proxy: intentionally separate from visual wedge geometry.
# Thin top slab so the test object is a walkable platform without filling its
# entire visual bounding box.
g collision_platform
v -0.75 -0.24 -1.60
v  0.75 -0.24 -1.60
v  0.75 -0.20 -0.40
v -0.75 -0.20 -0.40
